{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve project on localhost:8080",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\serve.ps1",
                "-Port",
                "8080"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "local-web-server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving .* at http://localhost:8080/$",
                    "endsPattern": "^Local server stopped\\.$"
                }
            }
        }
    ]
}
